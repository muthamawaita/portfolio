generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "mysql"
	url      = env("DATABASE_URL")
}

model Tenant {
	id        String    @id @default(cuid())
	name      String
	slug      String    @unique
	customDomain String? @unique
	plan      String    @default("STARTER")
	createdAt DateTime  @default(now())
	users     User[]
	projects  Project[]
	media     Media[]
	pages     SitePage[]
	branding  BrandSettings?
	subscription Subscription?
	payments  Payment[]
	resume    Resume?
	templates Template[]
	services  Service[]
	orders    Order[]
	invoices  Invoice[]
	plans     Plan[]
}

model User {
	id        String   @id @default(cuid())
	email     String   @unique
	name      String?
	passwordHash String?
	emailVerifiedAt DateTime?
	activationToken String? @unique
	activationExpires DateTime?
	passwordResetToken String? @unique
	passwordResetExpires DateTime?
	sessionToken String? @unique
	sessionExpires DateTime?
	role      String   @default("EDITOR")
	tenantId  String
	tenant    Tenant   @relation(fields: [tenantId], references: [id])
	createdAt DateTime @default(now())
	orders    Order[]
	subscriptions Subscription[]
	reviews   Review[]
	notifications Notification[]
}

model Project {
	id        String   @id @default(cuid())
	title     String
	slug      String
	summary   String
	content   Json?
	status    String   @default("DRAFT")
	tenantId  String
	tenant    Tenant   @relation(fields: [tenantId], references: [id])
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@unique([tenantId, slug])
}

model Media {
	id        String   @id @default(cuid())
	fileName  String
	url       String
	mimeType  String
	size      Int
	tenantId  String
	tenant    Tenant   @relation(fields: [tenantId], references: [id])
	createdAt DateTime @default(now())
	usages    MediaUsage[]
}

model SitePage {
	id          String   @id @default(cuid())
	tenantId    String
	tenant      Tenant   @relation(fields: [tenantId], references: [id])
	title       String
	slug        String
	content     Json
	status      String   @default("DRAFT")
	seoTitle    String?
	seoDescription String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@unique([tenantId, slug])
}

model BrandSettings {
	id          String @id @default(cuid())
	tenantId    String @unique
	tenant      Tenant @relation(fields: [tenantId], references: [id])
	primaryColor String @default("#e56d3f")
	backgroundColor String @default("#f3f0e8")
	fontFamily  String @default("Manrope")
	logoUrl     String?
}

model Subscription {
	id                   String                    @id @default(cuid())
	tenantId             String                    @unique
	tenant               Tenant                    @relation(fields: [tenantId], references: [id])
	userId               String?
	user                 User?                     @relation(fields: [userId], references: [id])
	plan                 String
	planId               String?
	planName             String?
	status               String                    @default("INACTIVE")
	billingCycle         String                    @default("MONTHLY")
	amountCents          Int?
	currency             String                    @default("KES")
	stripeCustomerId     String?
	stripeSubscriptionId String?                   @unique
	currentPeriodEnd     DateTime?
	startsAt             DateTime                  @default(now())
	renewalDate          DateTime?
	endsAt               DateTime?
	cancelledAt          DateTime?
	failedPayments       Int                       @default(0)
	createdAt            DateTime                  @default(now())
	updatedAt            DateTime                  @default(now()) @updatedAt
	transactions         SubscriptionTransaction[]
}

model Payment {
	id                String   @id @default(cuid())
	tenantId          String
	tenant            Tenant   @relation(fields: [tenantId], references: [id])
	provider           String   @default("STRIPE")
	providerPaymentId  String?  @unique
	amountCents        Int
	currency           String   @default("USD")
	status             String   @default("PENDING")
	createdAt          DateTime @default(now())
	transactions      PaymentTransaction[]
	refunds           Refund[]
}

model PaymentTransaction {
	id                String   @id @default(cuid())
	paymentId         String
	payment           Payment  @relation(fields: [paymentId], references: [id])
	gateway           String
	gatewayReference  String?
	amount            Decimal  @db.Decimal(10,2)
	currency          String   @default("KES")
	status            String   @default("PENDING")
	customerId        String?
	orderId           String?
	createdAt         DateTime @default(now())
	completedAt       DateTime?

	@@map("payment_transactions")
}

model Resume {
	id          String   @id @default(cuid())
	tenantId    String   @unique
	tenant      Tenant   @relation(fields: [tenantId], references: [id])
	template    String   @default("editorial")
	content     Json
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
}

model ContactLead {
	id        String   @id @default(cuid())
	name      String
	email     String
	phone     String?
	subject   String
	service   String?
	message   String   @db.Text
	status    String   @default("NEW")
	createdAt DateTime @default(now())

	@@index([status, createdAt])
	@@index([email])
}

model Template {
	id                 String   @id @default(cuid())
	name               String
	category           String
	version            String   @default("1.0.0")
	previewUrl         String?
	supportedSections  Json     @default("[]")
	defaultStyles      Json     @default("{}")
	premium            Boolean  @default(false)
	isPublished        Boolean  @default(true)
	tenantId           String?
	tenant             Tenant?  @relation(fields: [tenantId], references: [id])
	createdAt          DateTime @default(now())
	updatedAt          DateTime @updatedAt

	@@map("templates")
}

model Service {
	id              String          @id @default(cuid())
	name            String
	shortDescription String?
	fullDescription String?         @db.Text
	category        String
	startingPrice   Decimal?        @db.Decimal(10,2)
	currency        String          @default("KES")
	deliveryTime    String?
	features        Json            @default("[]")
	requirements    Json            @default("[]")
	faqs            Json            @default("[]")
	status          String          @default("ACTIVE")
	tenantId        String?
	tenant          Tenant?         @relation(fields: [tenantId], references: [id])
	packages        ServicePackage[]
	orders          Order[]
	createdAt       DateTime        @default(now())
	updatedAt       DateTime        @updatedAt

	@@map("services")
}

model ServicePackage {
	id          String   @id @default(cuid())
	serviceId   String
	service     Service  @relation(fields: [serviceId], references: [id])
	name        String
	description String?  @db.Text
	price       Decimal  @db.Decimal(10,2)
	currency    String   @default("KES")
	features    Json     @default("[]")
	isDefault   Boolean  @default(false)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt
	orders      Order[]

	@@map("service_packages")
}

model Order {
	id                String             @id @default(cuid())
	tenantId          String
	tenant            Tenant             @relation(fields: [tenantId], references: [id])
	userId            String
	user              User               @relation(fields: [userId], references: [id])
	serviceId         String?
	service           Service?           @relation(fields: [serviceId], references: [id])
	servicePackageId  String?
	servicePackage    ServicePackage?    @relation(fields: [servicePackageId], references: [id])
	orderNumber       String             @unique
	total             Decimal            @db.Decimal(10,2)
	currency          String             @default("KES")
	status            String             @default("PENDING_PAYMENT")
	paymentStatus     String             @default("PENDING")
	assignedStaffId   String?
	deadline          DateTime?
	createdAt         DateTime           @default(now())
	updatedAt         DateTime           @updatedAt
	items             OrderItem[]
	requirements      OrderRequirement[]
	assignments       OrderAssignment[]
	files             OrderFile[]
	messages          OrderMessage[]
	revisions         OrderRevision[]
	refunds           Refund[]
	invoices          Invoice[]

	@@map("orders")
}

model OrderItem {
	id        String   @id @default(cuid())
	orderId   String
	order     Order    @relation(fields: [orderId], references: [id])
	productType String
	productId String
	quantity  Int      @default(1)
	price     Decimal  @db.Decimal(10,2)
	currency  String   @default("KES")
	createdAt DateTime @default(now())

	@@map("order_items")
}

model OrderRequirement {
	id        String   @id @default(cuid())
	orderId   String
	order     Order    @relation(fields: [orderId], references: [id])
	key       String
	value     String   @db.Text
	createdAt DateTime @default(now())

	@@map("order_requirements")
}

model OrderAssignment {
	id          String   @id @default(cuid())
	orderId     String
	order       Order    @relation(fields: [orderId], references: [id])
	staffId     String
	status      String   @default("ASSIGNED")
	assignedAt  DateTime @default(now())

	@@map("order_assignments")
}

model OrderFile {
	id          String   @id @default(cuid())
	orderId     String
	order       Order    @relation(fields: [orderId], references: [id])
	name        String
	storageKey  String
	fileType    String
	sizeBytes   Int
	uploadedBy  String?
	createdAt   DateTime @default(now())

	@@map("order_files")
}

model OrderMessage {
	id        String   @id @default(cuid())
	orderId   String
	order     Order    @relation(fields: [orderId], references: [id])
	senderId  String
	senderRole String
	message   String   @db.Text
	createdAt DateTime @default(now())

	@@map("order_messages")
}

model OrderRevision {
	id              String    @id @default(cuid())
	orderId         String
	order           Order     @relation(fields: [orderId], references: [id])
	revisionNumber  Int
	instructions    String    @db.Text
	status          String    @default("OPEN")
	staffResponse   String?   @db.Text
	completedAt     DateTime?
	createdAt       DateTime  @default(now())

	@@map("order_revisions")
}

model Invoice {
	id            String   @id @default(cuid())
	tenantId      String
	tenant        Tenant   @relation(fields: [tenantId], references: [id])
	orderId       String?
	order         Order?   @relation(fields: [orderId], references: [id])
	invoiceNumber String   @unique
	amount        Decimal  @db.Decimal(10,2)
	currency      String   @default("KES")
	status        String   @default("PAID")
	issuedAt      DateTime @default(now())
	paidAt        DateTime?

	@@map("invoices")
}

model Refund {
	id          String   @id @default(cuid())
	paymentId   String?
	payment     Payment? @relation(fields: [paymentId], references: [id])
	orderId     String?
	order       Order?   @relation(fields: [orderId], references: [id])
	amount      Decimal  @db.Decimal(10,2)
	currency    String   @default("KES")
	reason      String   @db.Text
	status      String   @default("REQUESTED")
	requestedBy String?
	createdAt   DateTime @default(now())
	reviewedAt  DateTime?

	@@map("refunds")
}

model Plan {
	id            String   @id @default(cuid())
	tenantId      String?
	tenant        Tenant?  @relation(fields: [tenantId], references: [id])
	slug          String   @unique
	name          String
	description   String?  @db.Text
	priceMonthly  Decimal? @db.Decimal(10,2)
	priceYearly   Decimal? @db.Decimal(10,2)
	features      Json     @default("[]")
	isActive      Boolean  @default(true)
	createdAt     DateTime @default(now())
	updatedAt     DateTime @updatedAt

	@@map("plans")
}

model SubscriptionTransaction {
	id              String        @id @default(cuid())
	subscriptionId  String
	subscription    Subscription  @relation(fields: [subscriptionId], references: [id])
	gateway         String
	reference       String?
	amountCents     Int
	currency        String        @default("KES")
	status          String        @default("PENDING")
	createdAt       DateTime      @default(now())
	processedAt     DateTime?

	@@map("subscription_transactions")
}

model Coupon {
	id                  String         @id @default(cuid())
	code                String         @unique
	description         String?
	type                String         @default("PERCENTAGE")
	value               Decimal        @db.Decimal(10,2)
	currency            String         @default("KES")
	startAt             DateTime?
	endAt               DateTime?
	maxUses             Int?
	maxUsesPerUser      Int?
	minAmount           Decimal?       @db.Decimal(10,2)
	applicablePlans     Json           @default("[]")
	applicableServices  Json           @default("[]")
	isActive            Boolean        @default(true)
	createdAt           DateTime       @default(now())
	updatedAt           DateTime       @updatedAt
	usages              CouponUsage[]

	@@map("coupons")
}

model CouponUsage {
	id        String   @id @default(cuid())
	couponId  String
	coupon    Coupon   @relation(fields: [couponId], references: [id])
	userId    String?
	orderId   String?
	usedAt    DateTime @default(now())

	@@map("coupon_usage")
}

model PortfolioVisit {
	id          String   @id @default(cuid())
	tenantId    String?
	portfolioId String?
	visitorIp   String?
	path        String?
	referrer    String?
	country     String?
	device      String?
	userAgent   String?
	createdAt   DateTime @default(now())

	@@map("portfolio_visits")
}

model PortfolioEvent {
	id          String   @id @default(cuid())
	tenantId    String?
	portfolioId String?
	type        String
	metadata    Json     @default("{}")
	createdAt   DateTime @default(now())

	@@map("portfolio_events")
}

model AnalyticsDaily {
	id               String   @id @default(cuid())
	tenantId         String?
	date             DateTime
	visits           Int      @default(0)
	uniqueVisitors   Int      @default(0)
	projectViews     Int      @default(0)
	resumeDownloads  Int      @default(0)
	contactClicks    Int      @default(0)
	leads            Int      @default(0)
	revenueCents     Int      @default(0)
	createdAt        DateTime @default(now())

	@@unique([tenantId, date])
	@@map("analytics_daily")
}

model Lead {
	id          String   @id @default(cuid())
	tenantId    String?
	portfolioId String?
	name        String
	email       String
	phone       String?
	subject     String?
	message     String   @db.Text
	status      String   @default("NEW")
	source      String?
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@map("leads")
}

model ContactMessage {
	id        String   @id @default(cuid())
	name      String
	email     String
	phone     String?
	subject   String?
	message   String   @db.Text
	status    String   @default("NEW")
	createdAt DateTime @default(now())

	@@map("contact_messages")
}

model Review {
	id          String   @id @default(cuid())
	tenantId    String?
	userId      String?
	user        User?    @relation(fields: [userId], references: [id])
	serviceId   String?
	orderId     String?
	rating      Int      @default(5)
	title       String?
	comment     String?  @db.Text
	status      String   @default("PENDING")
	isVerified  Boolean  @default(false)
	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@map("reviews")
}

model Notification {
	id        String   @id @default(cuid())
	tenantId  String?
	userId    String?
	user      User?    @relation(fields: [userId], references: [id])
	type      String
	title     String
	body      String   @db.Text
	data      Json     @default("{}")
	isRead    Boolean  @default(false)
	createdAt DateTime @default(now())

	@@map("notifications")
}

model Conversation {
	id        String               @id @default(cuid())
	tenantId  String?
	subject   String?
	createdAt DateTime             @default(now())
	updatedAt DateTime             @updatedAt
	members   ConversationMember[]
	messages  Message[]

	@@map("conversations")
}

model ConversationMember {
	id            String       @id @default(cuid())
	conversationId String       
	conversation  Conversation @relation(fields: [conversationId], references: [id])
	userId        String
	role          String       @default("MEMBER")
	joinedAt      DateTime     @default(now())

	@@map("conversation_members")
}

model Message {
	id            String       @id @default(cuid())
	conversationId String       
	conversation  Conversation @relation(fields: [conversationId], references: [id])
	senderId      String
	body          String       @db.Text
	attachments   Json         @default("[]")
	createdAt     DateTime     @default(now())
	readAt        DateTime?

	@@map("messages")
}

model SupportTicket {
	id          String            @id @default(cuid())
	tenantId    String?
	userId      String?
	subject     String
	category    String
	priority    String            @default("MEDIUM")
	status      String            @default("OPEN")
	description String            @db.Text
	createdAt   DateTime          @default(now())
	updatedAt   DateTime          @updatedAt
	messages    SupportMessage[]

	@@map("support_tickets")
}

model SupportMessage {
	id          String        @id @default(cuid())
	ticketId    String
	ticket      SupportTicket @relation(fields: [ticketId], references: [id])
	senderId    String
	senderType  String        @default("USER")
	message     String        @db.Text
	attachments Json          @default("[]")
	createdAt   DateTime      @default(now())

	@@map("support_messages")
}

model BlogPost {
	id            String       @id @default(cuid())
	tenantId      String?
	title         String
	slug          String
	excerpt       String?
	content       String       @db.Text
	status        String       @default("DRAFT")
	featuredImage String?
	authorId      String?
	publishedAt   DateTime?
	createdAt     DateTime     @default(now())
	updatedAt     DateTime     @updatedAt
	categories    BlogPostTag[]
	comments      BlogComment[]

	@@unique([tenantId, slug])
	@@map("blog_posts")
}

model BlogCategory {
	id          String   @id @default(cuid())
	tenantId    String?
	name        String
	slug        String
	description String?
	createdAt   DateTime @default(now())

	@@map("blog_categories")
}

model BlogTag {
	id        String       @id @default(cuid())
	tenantId  String?
	name      String
	slug      String
	posts     BlogPostTag[]
	createdAt DateTime     @default(now())

	@@map("blog_tags")
}

model BlogPostTag {
	id        String    @id @default(cuid())
	postId    String
	post      BlogPost  @relation(fields: [postId], references: [id])
	tagId     String
	tag       BlogTag   @relation(fields: [tagId], references: [id])
	createdAt DateTime  @default(now())

	@@map("blog_post_tags")
}

model BlogComment {
	id          String   @id @default(cuid())
	postId      String
	post        BlogPost @relation(fields: [postId], references: [id])
	authorName  String
	authorEmail String?
	body        String   @db.Text
	status      String   @default("PENDING")
	createdAt   DateTime @default(now())

	@@map("blog_comments")
}

model MediaUsage {
	id        String   @id @default(cuid())
	mediaId   String
	media     Media    @relation(fields: [mediaId], references: [id])
	ownerType String
	ownerId   String
	usageType String
	createdAt DateTime @default(now())

	@@map("media_usage")
}

model Staff {
	id           String   @id @default(cuid())
	tenantId     String?
	userId       String?
	name         String
	email        String   @unique
	role         String   @default("STAFF")
	skills       Json     @default("[]")
	availability String?
	status       String   @default("ACTIVE")
	createdAt    DateTime @default(now())
	updatedAt    DateTime @updatedAt

	@@map("staff")
}

model SystemSetting {
	id          String   @id @default(cuid())
	key         String   @unique
	value       Json     @default("{}")
	description String?
	updatedAt   DateTime @updatedAt

	@@map("settings")
}

model EmailTemplate {
	id        String   @id @default(cuid())
	key       String   @unique
	subject   String?
	body      String   @db.Text
	category  String?
	updatedAt DateTime @updatedAt

	@@map("email_templates")
}

model AuditLog {
	id            String   @id @default(cuid())
	actorId       String?
	actorType     String?
	action        String
	resourceType  String?
	resourceId    String?
	oldValue      Json?
	newValue      Json?
	ipAddress     String?
	userAgent     String?
	createdAt     DateTime @default(now())

	@@map("audit_logs")
}
